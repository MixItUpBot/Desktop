<Project Sdk="Microsoft.NET.Sdk">

  	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<AssemblyTitle>MixItUp.Base</AssemblyTitle>
    <AssemblyVersion>1.8.201.0</AssemblyVersion>
    <FileVersion>1.8.201.0</FileVersion>
		<Company>Blazing Cacti LLC</Company>
		<Copyright>Copyright © 2026 Blazing Cacti LLC, All Rights Reserved. </Copyright>
		<Configurations>Debug;Dev;Public;Preview</Configurations>
	</PropertyGroup>

  <ItemGroup>
    <None Remove="XSplit\Mix It Up.html" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\..\.secrets\MixItUpSecrets.cs" Link="MixItUpSecrets.cs" />
  </ItemGroup>

	<ItemGroup>
		<Content Include="Deprecated\OverlayPageOld.html">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</Content>
		<Content Include="XSplit\Mix It Up.html">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="ExcelDataReader" Version="3.8.0" />
		<PackageReference Include="ExcelDataReader.DataSet" Version="3.8.0" />
		<PackageReference Include="Google.Apis.YouTube.v3" Version="1.74.0.4137" />
		<PackageReference Include="Google.Apis.YouTubePartner.v1" Version="1.35.1.1334" />
		<PackageReference Include="Jace" Version="1.0.0" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="SocketIOClient" Version="3.1.2" />
		<PackageReference Include="System.IO.Ports" Version="10.0.8" />
		<PackageReference Include="System.Net.ServerSentEvents" Version="10.0.8" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Resources.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Resources.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<None Update="LICENSE.txt">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="SettingsTemplateDatabase.db">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="OverlayResources\**\*" />
		<EmbeddedResource Update="Resources.resx">
