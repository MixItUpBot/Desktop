<local:ServiceControlBase x:Class="MixItUp.WPF.Controls.Services.VelumStudioServiceControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:MixItUp.WPF.Controls.Services"
 xmlns:resx="clr-namespace:MixItUp.Base;assembly=MixItUp.Base"
 xmlns:MaterialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
 <local:ServiceControlBase.Resources><BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" /></local:ServiceControlBase.Resources>
 <Grid Margin="10" HorizontalAlignment="Center">
  <Grid.ColumnDefinitions><ColumnDefinition Width="420"/><ColumnDefinition Width="20"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
  <TextBlock Text="{x:Static resx:Resources.VelumStudioInfo}" TextWrapping="Wrap"/>
  <StackPanel Grid.Column="2" Visibility="{Binding IsNotConnected, Converter={StaticResource BooleanToVisibilityConverter}}">
   <TextBox Text="{Binding WebSocketAddress, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15" Style="{StaticResource MaterialDesignFloatingHintTextBox}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.WebSocketAddress}" AutomationProperties.AutomationId="VelumStudioService.WebSocketAddressTextBox" AutomationProperties.Name="{x:Static resx:Resources.WebSocketAddress}"/>
   <PasswordBox x:Name="TokenPasswordBox" Margin="0,0,0,15" Style="{StaticResource MaterialDesignPasswordBox}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.VelumStudioToken}" AutomationProperties.AutomationId="VelumStudioService.TokenPasswordBox" AutomationProperties.Name="{x:Static resx:Resources.VelumStudioToken}"/>
   <TextBox Text="{Binding CertificateFingerprint, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15" Style="{StaticResource MaterialDesignFloatingHintTextBox}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.VelumStudioFingerprint}" AutomationProperties.AutomationId="VelumStudioService.FingerprintTextBox" AutomationProperties.Name="{x:Static resx:Resources.VelumStudioFingerprint}"/>
   <Button Command="{Binding ConnectCommand}" Content="{x:Static resx:Resources.Connect}" AutomationProperties.AutomationId="VelumStudioService.ConnectButton" HorizontalAlignment="Center" MinWidth="90"/>
  </StackPanel>
  <Button Grid.Column="2" Command="{Binding DisconnectCommand}" Content="{x:Static resx:Resources.Disconnect}" Visibility="{Binding IsConnected, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.AutomationId="VelumStudioService.DisconnectButton" HorizontalAlignment="Center" MinWidth="90"/>
 </Grid>
</local:ServiceControlBase>
