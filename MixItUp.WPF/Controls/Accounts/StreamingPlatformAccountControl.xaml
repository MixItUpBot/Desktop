<Controls:LoadingControlBase x:Class="MixItUp.WPF.Controls.Accounts.StreamingPlatformAccountControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:resx="clr-namespace:MixItUp.Base;assembly=MixItUp.Base"
             xmlns:System="clr-namespace:System;assembly=System.Runtime"
             xmlns:Controls="clr-namespace:MixItUp.WPF.Controls"
             xmlns:MaterialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <GroupBox Grid.Row="2" Header="{Binding PlatformName}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="35" />
                <RowDefinition Height="40" />
                <RowDefinition Height="50" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Image Source="{Binding PlatformImage, TargetNullValue={x:Null}}" Grid.Column="0" Grid.Row="0" Grid.RowSpan="3" Width="75" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="30,0,0,0" />

            
            
            <TextBlock Grid.Column="1" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Source={x:Static resx:Resources.Streamer}, StringFormat={x:Static resx:Resources.ColumnHeaderFormat}}" />

            <Grid Grid.Column="1" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" Source="{Binding StreamerAccountAvatar, TargetNullValue={x:Null}}" Height="24" Width="24" Visibility="{Binding IsStreamerAccountConnected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Grid.Column="2" Text="{Binding StreamerAccountUsername}" VerticalAlignment="Center" />
            </Grid>

            <Button Grid.Column="1" Grid.Row="2" Visibility="{Binding IsStreamerAccountLogInVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Command="{Binding StreamerAccountLogInCommand}" MinWidth="90" Width="210" Height="40" Background="{Binding ButtonColor}" AutomationProperties.AutomationId="StreamingPlatformAccount.StreamerAccountLogInButton" AutomationProperties.Name="{x:Static resx:Resources.Streamer}">
                <Grid HorizontalAlignment="Center" Margin="-5,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0" Source="{Binding ButtonImage, TargetNullValue={x:Null}}" Margin="0,3" Height="23" />

                    <TextBlock Grid.Column="2" Text="{Binding ButtonLoginText}" Foreground="{Binding ButtonTextForeground}" VerticalAlignment="Center" />
                </Grid>
            </Button>
            <Button Grid.Column="1" Grid.Row="2" Visibility="{Binding IsStreamerAccountCancelVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Command="{Binding StreamerAccountCancelCommand}" MinWidth="90" Width="210" Height="40" Background="{Binding ButtonColor}" MaterialDesign:ButtonProgressAssist.IsIndeterminate="True" MaterialDesign:ButtonProgressAssist.IsIndicatorVisible="True" MaterialDesign:ButtonProgressAssist.Value="-1" AutomationProperties.AutomationId="StreamingPlatformAccount.StreamerAccountCancelButton" AutomationProperties.Name="{x:Static resx:Resources.Streamer}">
                <Grid HorizontalAlignment="Center">
                    <TextBlock Grid.Column="2" Text="{x:Static resx:Resources.Cancel}" Foreground="{Binding ButtonTextForeground}" VerticalAlignment="Center" />
                </Grid>
            </Button>
            <Button Grid.Column="1" Grid.Row="2" Visibility="{Binding IsStreamerAccountLogoutVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Command="{Binding StreamerAccountLogOutCommand}" MinWidth="90" Width="210" Height="40" Background="{Binding ButtonColor}" AutomationProperties.AutomationId="StreamingPlatformAccount.StreamerAccountLogOutButton" AutomationProperties.Name="{x:Static resx:Resources.Streamer}">
                <Grid HorizontalAlignment="Center" Margin="-5,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0" Source="{Binding ButtonImage, TargetNullValue={x:Null}}" Margin="0,3" Height="23" />

                    <TextBlock Grid.Column="2" Text="{Binding ButtonLogoutText}" Foreground="{Binding ButtonTextForeground}" VerticalAlignment="Center" />
                </Grid>
            </Button>



            <TextBlock Grid.Column="2" Grid.Row="0" Visibility="{Binding HasBotAccountColumn, Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Source={x:Static resx:Resources.Bot}, StringFormat={x:Static resx:Resources.ColumnHeaderFormat}}" />

            <Grid Grid.Column="2" Grid.Row="1" Visibility="{Binding HasBotAccountColumn, Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" Source="{Binding BotAccountAvatar, TargetNullValue={x:Null}}" Height="24" Width="24" Visibility="{Binding IsStreamerAccountConnected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Grid.Column="2" Text="{Binding BotAccountUsername}" VerticalAlignment="Center" />
            </Grid>

            <Button Grid.Column="2" Grid.Row="2" Visibility="{Binding IsBotAccountLogInVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Command="{Binding BotAccountLogInCommand}" MinWidth="90" Width="210" Height="40" Background="{Binding ButtonColor}" AutomationProperties.AutomationId="StreamingPlatformAccount.BotAccountLogInButton" AutomationProperties.Name="{x:Static resx:Resources.Bot}">
                <Grid HorizontalAlignment="Center" Margin="-5,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0" Source="{Binding ButtonImage, TargetNullValue={x:Null}}" Margin="0,3" Height="23" />

                    <TextBlock Grid.Column="2" Text="{Binding BotButtonLoginText}" Foreground="{Binding ButtonTextForeground}" VerticalAlignment="Center" />
                </Grid>
            </Button>
            <Button Grid.Column="2" Grid.Row="2" Visibility="{Binding IsBotAccountCancelVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Command="{Binding BotAccountCancelCommand}" MinWidth="90" Width="210" Height="40" Background="{Binding ButtonColor}" MaterialDesign:ButtonProgressAssist.IsIndeterminate="True" MaterialDesign:ButtonProgressAssist.IsIndicatorVisible="True" MaterialDesign:ButtonProgressAssist.Value="-1" AutomationProperties.AutomationId="StreamingPlatformAccount.BotAccountCancelButton" AutomationProperties.Name="{x:Static resx:Resources.Bot}">
                <Grid HorizontalAlignment="Center">
                    <TextBlock Grid.Column="2" Text="{x:Static resx:Resources.Cancel}" Foreground="{Binding ButtonTextForeground}" VerticalAlignment="Center" />
                </Grid>
            </Button>
            <Button Grid.Column="2" Grid.Row="2" Visibility="{Binding IsBotAccountLogoutVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Command="{Binding BotAccountLogOutCommand}" MinWidth="90" Width="210" Height="40" Background="{Binding ButtonColor}" AutomationProperties.AutomationId="StreamingPlatformAccount.BotAccountLogOutButton" AutomationProperties.Name="{x:Static resx:Resources.Bot}">
                <Grid HorizontalAlignment="Center" Margin="-5,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0" Source="{Binding ButtonImage, TargetNullValue={x:Null}}" Margin="0,3" Height="23" />

                    <TextBlock Grid.Column="2" Text="{Binding BotButtonLogoutText}" Foreground="{Binding ButtonTextForeground}" VerticalAlignment="Center" />
                </Grid>
            </Button>

            <Button Grid.Column="2" Grid.Row="3" Visibility="{Binding IsBotAccountEditVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Command="{Binding BotAccountEditCommand}" MinWidth="90" Width="210" Height="32" Margin="0,8,0,0" Background="{Binding ButtonColor}" AutomationProperties.AutomationId="StreamingPlatformAccount.BotAccountEditButton" AutomationProperties.Name="{x:Static resx:Resources.Bot}">
                <TextBlock Text="{x:Static resx:Resources.VeloraEditBot}" Foreground="{Binding ButtonTextForeground}" VerticalAlignment="Center" />
            </Button>

            <TextBlock Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="4" Visibility="{Binding IsPlatformBotNoteVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Text="{Binding PlatformBotNoteText}" TextWrapping="Wrap" FontSize="{DynamicResource MIU.FontSize.BodySmall}" FontStyle="Italic" Opacity="0.75" HorizontalAlignment="Center" TextAlignment="Center" Margin="20,10,20,5" />
        </Grid>
    </GroupBox>
</Controls:LoadingControlBase>
