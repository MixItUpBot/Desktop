<Window x:Class="MixItUp.WPF.Windows.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:resx="clr-namespace:MixItUp.Base;assembly=MixItUp.Base"
        Title="{x:Static resx:Resources.CollectDiagnostics}" Width="650" Height="470" MinWidth="500" MinHeight="400"
        WindowStartupLocation="CenterOwner" Style="{StaticResource MaterialDesignWindow}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{x:Static resx:Resources.DiagnosticsConsent}" TextWrapping="Wrap" Margin="0,0,0,20"/>
            <CheckBox x:Name="Consent" Content="{x:Static resx:Resources.IUnderstand}" Margin="0,0,0,20"/>
            <TextBlock Text="{x:Static resx:Resources.DiagnosticsAccessCode}"/>
            <TextBox x:Name="AccessCode" MaxLength="6" CharacterCasing="Upper" Margin="0,8,0,20"/>
            <TextBlock x:Name="Status" TextWrapping="Wrap"/>
            <ProgressBar x:Name="Progress" IsIndeterminate="True" Visibility="Collapsed" Margin="0,16,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="RunButton" Content="{x:Static resx:Resources.CollectDiagnostics}" Click="Run_Click" Margin="0,0,12,0"/>
            <Button Content="{x:Static resx:Resources.Cancel}" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
