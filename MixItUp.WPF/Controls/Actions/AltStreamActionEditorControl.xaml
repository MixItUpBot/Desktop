<local:ActionEditorControlBase x:Class="MixItUp.WPF.Controls.Actions.AltStreamActionEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:resx="clr-namespace:MixItUp.Base;assembly=MixItUp.Base"
             xmlns:local="clr-namespace:MixItUp.WPF.Controls.Actions"
             xmlns:Util="clr-namespace:MixItUp.WPF.Util"
             xmlns:MaterialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <local:ActionEditorControlBase.Resources>
        <Util:LocalizationConverter x:Key="LocalizationConverter"/>
    </local:ActionEditorControlBase.Resources>

    <StackPanel>
        <ComboBox ItemsSource="{Binding ActionTypes}" SelectedItem="{Binding SelectedActionType}" MaterialDesign:HintAssist.Hint="{x:Static resx:Resources.Type}" Style="{StaticResource MaterialDesignFloatingHintComboBox}" Margin="0,0,0,10" AutomationProperties.AutomationId="AltStreamActionEditor.TypeComboBox" AutomationProperties.Name="{x:Static resx:Resources.Type}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource LocalizationConverter}}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBox Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" MaterialDesign:HintAssist.Hint="{Binding TargetHint}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AutomationProperties.AutomationId="AltStreamActionEditor.TargetTextBox" AutomationProperties.Name="{Binding TargetHint}" />
    </StackPanel>
</local:ActionEditorControlBase>
