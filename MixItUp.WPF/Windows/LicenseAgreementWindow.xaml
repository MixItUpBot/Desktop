<Window
    x:Class="MixItUp.WPF.Windows.LicenseAgreementWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:MixItUp.WPF.Controls"
    xmlns:MaterialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:MixItUp.Base;assembly=MixItUp.Base"
    xmlns:markdown="clr-namespace:MdXaml;assembly=MdXaml"
    Title="{x:Static resx:Resources.LicenseAgreement}"
    Width="600"
    Height="450"
    FontFamily="{DynamicResource NotoSans}"
    Style="{StaticResource MaterialDesignWindow}"
    TextElement.FontSize="{DynamicResource MIU.FontSize.BodyMedium}"
    TextElement.FontWeight="Medium"
    mc:Ignorable="d">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <markdown:MarkdownScrollViewer x:Name="AgreementContent" Grid.Row="0" />

        <Grid Grid.Row="2" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="LicenseAgreementAcceptButton"
                Grid.Column="0"
                Click="AcceptButton_Click"
                Content="{x:Static resx:Resources.Accept}"
                Style="{StaticResource MaterialDesignRaisedButton}"
                AutomationProperties.AutomationId="LicenseAgreement.AcceptButton" />
            <Button
                x:Name="LicenseAgreementCancelButton"
                Grid.Column="2"
                Click="CancelButton_Click"
                Content="{x:Static resx:Resources.Cancel}"
                Style="{StaticResource MaterialDesignOutlinedButton}"
                AutomationProperties.AutomationId="LicenseAgreement.CancelButton" />
        </Grid>
    </Grid>
</Window>
