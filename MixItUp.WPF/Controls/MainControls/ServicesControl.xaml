<local:MainControlBase x:Class="MixItUp.WPF.Controls.MainControls.ServicesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:resx="clr-namespace:MixItUp.Base;assembly=MixItUp.Base"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MixItUp.WPF.Controls.MainControls"
             xmlns:Controls="clr-namespace:MixItUp.WPF.Controls"
             xmlns:MaterialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
                          
    FontFamily="{DynamicResource NotoSans}"
    TextElement.FontSize="{DynamicResource MIU.FontSize.BodyMedium}"
    TextElement.FontWeight="Medium"                  
                          
             d:DesignHeight="500" d:DesignWidth="600">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Button x:Name="ReconnectServicesButton" Content="{x:Static resx:Resources.ReconnectServices}" HorizontalAlignment="Right" Margin="0,0,0,16" Click="ReconnectServicesButton_Click" AutomationProperties.AutomationId="Services.Reconnect" />
        <ListView Grid.Row="1" x:Name="ServicesListView" ItemContainerStyle="{StaticResource BorderedListViewItem}" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="Services.ServicesList" AutomationProperties.Name="{x:Static resx:Resources.Services}" />
    </Grid>
</local:MainControlBase>
